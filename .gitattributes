# Auto detect text files and perform LF normalization
* text=auto

# Explicitly declare text files to always use LF
*.md text
*.txt text
*.json text
*.yaml text
*.yml text
*.toml text
*.js text
*.mjs text
*.ts text
*.tsx text
*.css text
*.html text
*.xml text
*.svg text
*.sh text
*.py text
*.dockerfile text
Dockerfile text
Makefile text
justfile text
*.gitignore text
*.gitattributes text
*.editorconfig text

# Scripts - LF for cross-platform compatibility
scripts/*.mjs text eol=lf
scripts/*.sh text eol=lf

# Workflow files - LF
.github/workflows/*.yml text eol=lf
.github/workflows/*.yaml text eol=lf

# Configuration files - LF
*.config.* text eol=lf
*.rc text eol=lf

# Documentation - LF
docs/**/*.md text eol=lf
content/**/*.md text eol=lf
profile/**/*.md text eol=lf
system/**/*.md text eol=lf

# Windows-specific scripts (if any) - preserve CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf